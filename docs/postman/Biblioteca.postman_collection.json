    {
      "name": "03 Reservas",
      "description": "Cada POST exitoso registra una reserva nueva. Usar Laura (DEMO-001) para mantener a Diego sin reservas. Cada alta conserva su último ID en idReservation.",
      "item": [
        {
          "name": "01 Registrar reserva de dos libros — 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reservations",
            "description": "01 Registrar reserva de dos libros — 201",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationDate\": \"{{reservationDate}}\",\n  \"idClient\": {{idClient}},\n  \"details\": [\n    {\n      \"idBook\": {{idBook}}\n    },\n    {\n      \"idBook\": {{idBook2}}\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  " const location = pm.response.headers.get('Location');",
                  " pm.test('Cabecera Location', () => pm.expect(location).to.match(/\\/\\d+$/));",
                  " if (location) pm.collectionVariables.set('idReservation', location.split('/').pop());",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 Consultar reserva registrada — 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reservations/{{idReservation}}",
            "description": "02 Consultar reserva registrada — 200"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Reserva con libros\", () => pm.expect(pm.response.json().details.length).to.be.at.least(1));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03 Consultar por cliente — 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
